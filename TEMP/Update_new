    "B": "Correct. 500 × 0.40 = 200 person-days.",
    "C": "Incorrect. 500 × 0.60 = 300 person-days, but the stated ratio is 40%.",
    "D": "Incorrect. 500 × 0.80 = 400 person-days, but the stated ratio is 40%."
  },
  "chapter": 5,
  "section": "5.1",
  "subsection": "5.1.4",
  "learningObjective": "FL-5.1.4",
  "kLevel": "K3",
  "difficulty": "Medium",
  "keywords": [
    "test estimation",
    "estimation based on ratios",
    "historical data",
    "test effort"
  ],
  "examTip": "Estimation based on ratios uses historical data to derive a ratio that can be applied to a new project's estimated effort.",
  "memoryAid": "Historical ratio × current effort = estimated effort."
